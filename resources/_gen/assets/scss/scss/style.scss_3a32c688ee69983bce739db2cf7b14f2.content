;pointer-events:none}.ornate-nav__link:hover .ornate-nav__image--default,.ornate-nav__link:focus-visible .ornate-nav__image--default,.ornate-nav__link.is-current .ornate-nav__image--default{opacity:0}.ornate-nav__link:hover .ornate-nav__image--active,.ornate-nav__link:focus-visible .ornate-nav__image--active,.ornate-nav__link.is-current .ornate-nav__image--active{opacity:1}.ornate-nav__link:hover .ornate-nav__image,.ornate-nav__link:focus-visible .ornate-nav__image{transform:scale(1.06)}#header-left,#logo-wrap,#home-link-img,#logo,#nav-divider,#title,.nav-menu,.menu-image-link,.menu-img{display:none !important}.ornate-nav__link:focus-visible,.home-badge:focus-visible{outline:2px solid currentColor;outline-offset:0.25rem}#header,.ornate-header,.ornate-header__canvas,.ornate-nav,.ornate-nav__list{pointer-events:none}.home-badge,.ornate-nav__link{pointer-events:auto}.home-badge__frame,.home-badge__icon,.ornate-nav__bar,.ornate-nav__image{pointer-events:none}@media screen and (min-width: 581px) and (max-width: 900px){.ornate-header__canvas{--header-ratio-h: 195;--home-x: 1.5%;--home-y: -10%;--home-w: 18%;--nav-x: 20%;--nav-y: -5%;--nav-w: 80%;--nav-h: 42%;--bar-w: 95%;--bar-top-y: 0%;--bar-bottom-y: 110%;--menu-x: 8%;--menu-y: 80%;--menu-w: 90%;--menu-h: 65%;--menu-gap: 3%}}@media screen and (max-width: 580px){.ornate-header__canvas{--header-ratio-h: 205;--home-x: 0.5%;--home-y: -10%;--home-w: 18%;--nav-x: 21%;--nav-y: -5%;--nav-w: 80%;--nav-h: 42%;--bar-w: 100%;--bar-top-y: 0%;--bar-bottom-y: 110%;--menu-x: 8%;--menu-y: 80%;--menu-w: 90%;--menu-h: 65%;--menu-gap: 3%}}@media screen and (min-width: 581px) and (max-width: 900px){:root{--tablet-body-font: 17px;--tablet-header-h1-font: 18px;--tablet-main-h1-font: 1.6rem;--tablet-nav-link-font: 12px;--tablet-directory-summary-font: 19.5px;--tablet-directory-details-font: 17px;--tablet-katex-font: 17px;--tablet-section-label-font: 18px;--tablet-time-font: 16px;--tablet-gallery-number-height: 22px;--tablet-gallery-button-font: 24px;--tablet-gallery-arrow-font: 24px;--tablet-simrow-text-font: 1,2rem;--tablet-simrow-heading-font: 1.3rem;--tablet-simrow-control-font: 1.2rem;--tablet-h2-font: 1.25rem}body{font-size:var(--tablet-body-font)}header h1{font-size:var(--tablet-header-h1-font) !important}h1{font-size:var(--tablet-main-h1-font)}h2,.page-markdown h2,.hermit-content .page-markdown h2{font-size:var(--tablet-h2-font)}#nav a{font-size:var(--tablet-nav-link-font)}body.kind-section.section-photography summary,body.kind-section.section-art-and-poetry summary,body.kind-section.section-academia summary{font-size:var(--tablet-directory-summary-font)}body.kind-section.section-photography details,body.kind-section.section-art-and-poetry details,body.kind-section.section-academia details{font-size:var(--tablet-directory-details-font)}.katex{font-size:var(--tablet-katex-font) !important}.section-label{font-size:var(--tablet-section-label-font) !important}time,.time{font-size:var(--tablet-time-font) !important}.gallery .photo-buttons .number-img{height:var(--tablet-gallery-number-height)}.gallery .photo-buttons button{font-size:var(--tablet-gallery-button-font)}.gallery .photo-buttons #prev-photo,.gallery .photo-buttons #next-photo{font-size:var(--tablet-gallery-arrow-font)}.simrow-text{font-size:var(--tablet-simrow-text-font)}.simrow-text h1{font-size:var(--tablet-simrow-heading-font)}.simrow-categories button,.coord-group button{font-size:var(--tablet-simrow-control-font)}}@media screen and (max-width: 580px){:root{--mobile-h2-font: 0.7rem;--mobile-section-label-font: 11px;--mobile-time-font: 11px}h2,.page-markdown h2,.hermit-content .page-markdown h2{font-size:var(--mobile-h2-font)}.section-label{font-size:var(--mobile-section-label-font) !important}time,.time{font-size:var(--mobile-time-font) !important}.hermit-content{padding-bottom:20px !important}}

